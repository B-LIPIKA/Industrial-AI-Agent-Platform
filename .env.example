# EngineMind AI Configuration Template
# Copy to .env and adjust variables as needed

# Local Ollama Configuration (Optional - deterministic analytics always work without LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Hosted Model Interface (Optional)
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL_NAME=gpt-4o-mini

# Server Port Configurations
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# Dataset & Model Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODELS_DIR=models/saved
DOCS_DIR=docs/technical_manuals
